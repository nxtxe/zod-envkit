{
  "name": "next-app-env-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')){ fs.copyFileSync('.env.example','.env'); console.log('Created .env from .env.example'); }\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "env:gen": "zod-envkit generate",
    "env:check": "zod-envkit check --dotenv .env,.env.example",
    "env:show": "zod-envkit show"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^4.3.0",
    "zod-envkit": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.0.0"
  }
}
